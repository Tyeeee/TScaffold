<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      basic（基础能力）
      依赖了 component_basic 的模块，manifest 合并后就会带上这里声明的东西，
      Application 里不用再写初始化代码。
    -->

    <application>

        <!--
          AndroidX Startup：进程一起来（Application.onCreate 之前）先把基础能力初始化掉。
          现在挂的是 MMKV 封装（MMKVUtils）。

          以后再加"启动要做的事"，照着加一行 meta-data 就行：
              <meta-data
                  android:name="你的 Initializer 全类名"
                  android:value="androidx.startup" />

          tools:node="merge" 是给多个模块都声明这个 provider 时用的（合并而不是替换）。
          不想让 basic 管初始化，在 app 的清单里给这个 provider 加 tools:node="remove" 即可。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.tscaffold.basic.mmkv.MMKVInitializer"
                android:value="androidx.startup" />
        </provider>

        <!--
          FileProvider（**预留**，现在没人用）：把应用内部的文件以 content:// 形式交给相机、
          系统选择器或者别的 App，Android 7 以后不给 file:// 了。
          路径白名单在同模块的 res/xml/basic_file_paths.xml，需要别的目录就往那加。

          用法：FileProvider.getUriForFile(context, context.packageName + ".fileprovider", file)
          authorities 用 applicationId 前缀，免得跟别的 App 撞车。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/basic_file_paths" />
        </provider>

    </application>

</manifest>
