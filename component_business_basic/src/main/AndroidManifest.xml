<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      component_business_basic（示例业务层）
      这里放的是"任务列表"这一个示例的两种写法，你要写自己的页面时照抄它们即可：
      - TaskActivity        ：XML 版（BaseActivity 承载 BaseFragment，列表在 Fragment 里）
      - TaskComposeActivity ：Compose 版
      两者共用同一个 TaskViewModel 和同一份 TaskContract。
    -->
    <application>

        <activity
            android:name="com.tscaffold.component.business.basic.ui.task.view.TaskActivity"
            android:exported="false"
            android:theme="@style/business_basic_theme" />

        <activity
            android:name="com.tscaffold.component.business.basic.ui.task.compose.TaskComposeActivity"
            android:exported="false"
            android:theme="@style/business_basic_theme" />

    </application>

</manifest>
